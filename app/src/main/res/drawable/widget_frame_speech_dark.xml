<!--
  Varian gelap widget_frame_speech.xml. Insets bawah 19dp sama dengan versi
  terang, karena pitanya ada di layout dan tidak ikut berubah bersama tema.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="19dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A2530" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#7FC0E8" />
        </shape>
    </item>
</layer-list>
