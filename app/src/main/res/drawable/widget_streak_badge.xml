<!--
  Latar badge rentetan di sudut foto widget: isian PeachAccent dengan sudut
  membulat penuh. Di ukuran sekecil ini (tinggi sekitar 22dp) radius besar
  memang yang paling pas, karena badge-nya harus terbaca sebagai satu kepingan
  utuh di atas foto, bukan sebagai kartu kecil.

  Warna latarnya dari aksen tetap app, jadi satu varian cukup untuk tema terang
  dan gelap.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFB27A" />
    <corners android:radius="11dp" />
</shape>
