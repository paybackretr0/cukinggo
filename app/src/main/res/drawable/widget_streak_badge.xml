<!--
  Latar badge rentetan di sudut foto widget: isian IceDeep dengan sudut membulat
  penuh. Di ukuran sekecil ini (tinggi sekitar 22dp) radius besar memang yang
  paling pas, karena badge-nya harus terbaca sebagai satu kepingan utuh di atas
  foto, bukan sebagai kartu kecil.

  Warna latarnya dari aksen tetap app, sama di tema terang dan gelap, jadi satu
  varian cukup. IceDeep, bukan IceAccent, supaya angka dan api putih di atasnya
  lolos kontras.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2F6E96" />
    <corners android:radius="11dp" />
</shape>
