<!--
  Bingkai bentuk balon bicara, mode terang: badan membulat penuh dengan garis
  tepi tipis warna IceAccent. Sudut membulat penuh dipakai karena balon bicara
  memang tidak punya sudut, sedangkan bentuk stiker justru sebaliknya.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2F7FB" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#5FA8D3" />
</shape>
