<!--
  Bingkai bentuk balon bicara, mode terang: badan membulat penuh dengan garis
  tepi tipis warna IceAccent. Sudut membulat penuh dipakai karena balon bicara
  memang tidak punya sudut, sedangkan bentuk stiker justru sebaliknya.

  Badannya sengaja dimasukkan 19dp dari tepi bawah, sama seperti bentuk stiker
  yang dimasukkan dari tepi atas. Sisa 19dp itu dipakai pita ekor: ekornya
  berdiri di tepi bawah badan balon dan ujungnya mencuat keluar, bukan
  tergambar di dalam kartu. 19dp = pita ekor 13dp + padding 6dp layout; kalau
  salah satu angkanya berubah, keduanya harus ikut disesuaikan.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="19dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2F7FB" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#5FA8D3" />
        </shape>
    </item>
</layer-list>
