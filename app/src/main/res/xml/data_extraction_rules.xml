<?xml version="1.0" encoding="utf-8"?><!--
   Data kucing tidak ikut cloud backup (tetap murni lokal), tapi masih boleh
   dipindah lewat transfer perangkat ke perangkat saat ganti HP.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="osmdroid.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
